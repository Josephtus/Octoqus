# =============================================================================
# Octoqus - Environment Variables Template
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=octoqus_db
MYSQL_USER=octoqus_user
MYSQL_PASSWORD=your_db_password_here

# --- Redis ---
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# --- Database URL (SQLAlchemy Async) ---
DATABASE_URL=mysql+aiomysql://octoqus_user:your_db_password_here@db:3306/octoqus_db

# --- Sanic ---
SANIC_ENV=production
SANIC_HOST=0.0.0.0
SANIC_PORT=8000
SANIC_DEBUG=false
SANIC_WORKERS=1
SANIC_WORKER_STARTUP_TIMEOUT=60.0

# --- JWT ---
# Üretmek için: openssl rand -hex 64
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=300

# --- CORS ---
# Development: CORS_ORIGINS=*
# Production: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# --- SMTP (Şifre sıfırlama e-postaları için) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FRONTEND_URL=https://yourdomain.com
